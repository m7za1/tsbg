        Text = label, TextColor3 = Color3.fromRGB(220, 215, 245), TextSize = 11,
        Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local box = make("TextBox", {
        Size = UDim2.new(0.36, 0, 0, 20), Position = UDim2.new(0.62, 0, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(38, 32, 75), BorderSizePixel = 0,
        Text = tostring(Config[key]), TextColor3 = Color3.new(1, 1, 1), TextSize = 11,
        Font = Enum.Font.Gotham, ClearTextOnFocus = false,
    }, row)
    make("UICorner", {CornerRadius = UDim.new(0, 4)}, box)
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n and n == n then
            Config[key] = n
        end
        box.Text = tostring(Config[key])
    end)
end

local function addBool(label, key)
    local btn = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), BorderSizePixel = 0,
        TextColor3 = Color3.new(1, 1, 1), TextSize = 11, Font = Enum.Font.GothamMedium,
    }, panel)
    make("UICorner", {CornerRadius = UDim.new(0, 4)}, btn)
    local function refresh()
        btn.Text = label .. ": " .. (Config[key] and "ON" or "OFF")
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(70, 50, 160) or Color3.fromRGB(35, 30, 60)
    end
    refresh()
    btn.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        refresh()
    end)
end

