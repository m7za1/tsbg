local function create(className, properties, children)
    local instance = Instance.new(className)
    local parent = properties.Parent
    for name, value in pairs(properties) do
        if name ~= "Parent" then
            instance[name] = value
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = instance
    end
    if parent then
        instance.Parent = parent
    end
    return instance
end

local function corner(scale, offset)
    return create("UICorner", {CornerRadius = UDim.new(scale, offset)})
end

local function stroke(transparency)
    return create("UIStroke", {
        Color = Theme.StrokeColor,
        Transparency = transparency or Theme.StrokeTransparency,
        Thickness = 1,
