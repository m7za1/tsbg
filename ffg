function Page:AddButton(options)
    local callback = options.Callback or function() end
    local danger = options.Danger == true
    self.Order = self.Order + 1
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = danger and Theme.Danger or Theme.Accent,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Theme.Font,
        Text = options.Name,
        TextSize = 14,
        TextColor3 = danger and Theme.OnDanger or Theme.OnAccent,
        LayoutOrder = self.Order,
        Parent = self.Scroll,
    }, {corner(0, Theme.RowCorner)})

    local function release()
        animate(button, {BackgroundTransparency = 0}, true)
    end
    self.Track(button.MouseButton1Down:Connect(function()
        animate(button, {BackgroundTransparency = 0.25}, true)
    end))
    self.Track(button.MouseButton1Up:Connect(release))
    self.Track(button.MouseLeave:Connect(release))
    self.Track(button.Activated:Connect(function()
        task.spawn(callback)
    end))

    local control = {Button = button}
    function control:SetText(text)
        button.Text = text
    end
    return control
end

function GlassUI.new(options)
    options = options or {}
    local title = options.Title or "GlassUI"
    local subtitle = options.Subtitle
    local onClose = options.OnClose

    local connections = {}
    local function track(connection)
        table.insert(connections, connection)
        return connection
    end

    local gui = create("ScreenGui", {
        Name = "SolitudeTechUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    mountGui(gui)

    local windowScale = create("UIScale", {Scale = 1})
    local window = create("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(0.9, 0.85),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = Theme.WindowTransparency,
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    }, {
        corner(0, Theme.Corner),
        stroke(),
        create("UISizeConstraint", {MinSize = Vector2.new(260, 180), MaxSize = Vector2.new(Theme.WindowMaxWidth, Theme.WindowMaxHeight)}),
        glassGradient(),
        windowScale,
    })

    local sidebar = create("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(8, 8),
        Size = UDim2.new(0, 48, 1, -16),
        BackgroundColor3 = Theme.SidebarColor,
        BackgroundTransparency = Theme.SidebarTransparency,
        BorderSizePixel = 0,
        Parent = window,
    }, {corner(0, 10), stroke(0.85)})

    local tabList = create("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = sidebar}, {
        create("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }),
        create("UIPadding", {PaddingTop = UDim.new(0, 6)}),
    })

    local content = create("Frame", {
        Name = "Content",
        Position = UDim2.fromOffset(64, 0),
        Size = UDim2.new(1, -72, 1, 0),
        BackgroundTransparency = 1,
        Parent = window,
    })
    local titleBar = create("Frame", {Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = content})
    local titleLabel = label({
        Size = UDim2.new(1, -84, 0, subtitle and 22 or 40),
        Position = UDim2.fromOffset(4, subtitle and 2 or 0),
        Text = title,
        TextSize = 15,
        RichText = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = titleBar,
    })
    if subtitle then
        label({
            Size = UDim2.new(1, -84, 0, 14),
            Position = UDim2.fromOffset(4, 24),
            Text = subtitle,
            TextSize = 11,
            TextColor3 = Theme.TextMuted,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = titleBar,
        })
    end
    local minimizeButton = create("TextButton", {
        Size = UDim2.fromOffset(36, 36),
        Position = UDim2.new(1, -72, 0, 2),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Parent = titleBar,
    }, {
        create("Frame", {
            Size = UDim2.fromOffset(12, 2),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            BackgroundColor3 = Theme.TextMuted,
            BorderSizePixel = 0,
        }, {corner(1, 0)}),
    })
    local closeButton = create("TextButton", {
        Size = UDim2.fromOffset(32, 32),
        Position = UDim2.new(1, -34, 0, 4),
        BackgroundColor3 = Theme.Danger,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Font = Theme.Font,
        Text = "\u{D7}",
        TextSize = 22,
        TextColor3 = Theme.TextMuted,
        Parent = titleBar,
    }, {corner(0, Theme.RowCorner)})
    create("Frame", {
        Position = UDim2.fromOffset(0, 40),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        Parent = content,
    })
    local pages = create("Frame", {
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(1, 0, 1, -56),
        BackgroundTransparency = 1,
        Parent = content,
    })

    local edgeHint = create("Frame", {
        Name = "EdgeHint",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.fromOffset(Theme.StickWidth, 48),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = gui,
    }, {corner(1, 0)})

    local restPosition = window.Position
    local shown = false
    local stickPosition = UDim2.new(0, 2 + Theme.StickWidth / 2, 0.5, 0)
    local windowStrokes = snapshotStrokes(window)
    local animator = createAnimator(function(progress)
        windowScale.Scale = SeedScale + (1 - SeedScale) * progress
        window.Position = stickPosition:Lerp(restPosition, progress)
        fadeStrokes(windowStrokes, progress)
    end)

    local self = {Gui = gui, Window = window, CloseButton = closeButton, Track = track}
    local tabs = {}
    local visibilityCallbacks = {}

    local function selectTab(tab)
        for _, other in ipairs(tabs) do
            local selected = other == tab
            other.Scroll.Visible = selected
            animate(other.Button, {BackgroundTransparency = selected and 0.78 or 1}, true)
            animate(other.Glyph, {[other.ColorProperty] = selected and Theme.Accent or Theme.TextMuted}, true)
        end
        titleLabel.Text = string.format('%s <font color="%s">/ %s</font>', title, toHex(Theme.TextMuted), tab.Name)
    end

    function self:OnVisibility(callback)
        table.insert(visibilityCallbacks, callback)
    end

    function self:SetVisible(visible)
        if visible == shown then
            return
        end
        shown = visible

        if visible then
            if not window.Visible then
                animator.Set(0)
                window.Visible = true
            end
            animator.To(1, WindowShowTween)
            animate(edgeHint, {BackgroundTransparency = 1}, false)
        else
            if animator.Get() >= 1 then
                restPosition = window.Position
            end
            animator.To(0, WindowHideTween, function()
                window.Visible = false
                animate(edgeHint, {BackgroundTransparency = 0.45}, true)
            end)
        end

        for _, callback in ipairs(visibilityCallbacks) do
            task.spawn(callback, visible)
        end
    end

    function self:AddTab(tabOptions)
        local name = tabOptions.Name
        local icon = tabOptions.Icon or string.sub(name, 1, 1)

        local button = create("TextButton", {
            Size = UDim2.fromOffset(36, 36),
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            LayoutOrder = #tabs + 1,
            Parent = tabList,
        }, {corner(0, Theme.RowCorner)})

        local glyph, colorProperty
        if string.sub(icon, 1, 13) == "rbxassetid://" then
            colorProperty = "ImageColor3"
            glyph = create("ImageLabel", {
                Size = UDim2.fromOffset(20, 20),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                BackgroundTransparency = 1,
                Image = icon,
                ImageColor3 = Theme.TextMuted,
                Parent = button,
            })
        else
            colorProperty = "TextColor3"
            glyph = label({
                Size = UDim2.fromScale(1, 1),
                Text = icon,
                TextSize = 16,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextColor3 = Theme.TextMuted,
                Parent = button,
            })
        end

        local scroll = create("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new(),
            Visible = false,
            Parent = pages,
        }, {
            create("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}),
            create("UIPadding", {PaddingRight = UDim.new(0, 6)}),
        })

        local tab = {Name = name, Button = button, Glyph = glyph, ColorProperty = colorProperty, Scroll = scroll}
        table.insert(tabs, tab)
        track(button.Activated:Connect(function()
            selectTab(tab)
        end))
        if #tabs == 1 then
            selectTab(tab)
        end
        return setmetatable({Scroll = scroll, Order = 0, Track = track}, Page)
    end

    function self:Destroy()
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)
        animator.Destroy()
        gui:Destroy()
    end

    track(minimizeButton.Activated:Connect(function()
        self:SetVisible(false)
    end))
    track(closeButton.Activated:Connect(function()
        if onClose then
            onClose()
        else
            self:SetVisible(false)
        end
    end))
    makeDraggable(titleBar, window, track)

    local swipeInput, swipeOrigin
    track(UIS.InputBegan:Connect(function(input)
        if shown then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        if input.Position.X <= Theme.SwipeEdgeWidth then
            swipeInput = input
            swipeOrigin = input.Position
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if not swipeInput or shown then
            return
        end
        local isMouseDrag = swipeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        if input ~= swipeInput and not isMouseDrag then
            return
        end
        local delta = input.Position - swipeOrigin
        if delta.X >= Theme.SwipeDistance and math.abs(delta.Y) <= delta.X * 0.75 then
            swipeInput = nil
            self:SetVisible(true)
        elseif math.abs(delta.Y) > 40 and math.abs(delta.Y) > delta.X then
            swipeInput = nil
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        if swipeInput and isSamePointer(input, swipeInput) then
            swipeInput = nil
        end
    end))
    track(UIS.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Theme.ToggleKey then
            self:SetVisible(not shown)
        end
    end))

    self:SetVisible(true)
    return self
end

