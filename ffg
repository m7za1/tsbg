            Text = subtitle,
            TextSize = 11,
            TextColor3 = Theme.TextMuted,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = titleBar,
        })
    end
    local minimizeButton = create("TextButton", {
        Size = UDim2.fromOffset(36, 36),
        Position = UDim2.new(1, -72, 0, 2),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        Parent = titleBar,
    }, {
        create("Frame", {
