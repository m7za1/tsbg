end

local function animate(instance, goal, animated)
    if animated then
        TweenService:Create(instance, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
    else
        for name, value in pairs(goal) do
            instance[name] = value
        end
    end
end

local function snapshotStrokes(root)
    local list = {}
    for _, descendant in ipairs(root:GetDescendants()) do
        if descendant:IsA("UIStroke") then
            table.insert(list, {Stroke = descendant, Transparency = descendant.Transparency})
        end
    end
    return list
end

local function fadeStrokes(list, progress)
    local fade = math.clamp((progress - 0.55) / 0.45, 0, 1)
    for _, entry in ipairs(list) do
        entry.Stroke.Transparency = 1 - (1 - entry.Transparency) * fade
    end
end

local function createAnimator(apply)
    local value = Instance.new("NumberValue")
    local connection = value.Changed:Connect(apply)
    local tween
    local animator = {}

    function animator.Get()
        return value.Value
    end

    function animator.Set(progress)
        if tween then
            tween:Cancel()
            tween = nil
        end
        value.Value = progress
        apply(progress)
    end

    function animator.To(goal, info, onDone)
        if tween then
            tween:Cancel()
        end
        local current = TweenService:Create(value, info, {Value = goal})
        tween = current
        current.Completed:Connect(function(state)
            if tween == current then
                tween = nil
            end
            if state == Enum.PlaybackState.Completed and onDone then
                onDone()
            end
        end)
        current:Play()
    end

    function animator.Destroy()
        if tween then
            tween:Cancel()
        end
        connection:Disconnect()
        value:Destroy()
    end

    return animator
end

local function toHex(color)
    return string.format(
        "#%02X%02X%02X",
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isSamePointer(input, active)
    return input == active
        or (active.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1)
end

local function formatNumber(value)
    return tostring(math.floor(value * 1000 + 0.5) / 1000)
end

local function mountGui(gui)
    local resolvers = {}
    if typeof(gethui) == "function" then
        table.insert(resolvers, function()
            return gethui()
        end)
    end
    table.insert(resolvers, function()
        return CoreGui
    end)
    table.insert(resolvers, function()
        return player:WaitForChild("PlayerGui")
    end)
    for _, resolve in ipairs(resolvers) do
        local ok = pcall(function()
            gui.Parent = resolve()
        end)
        if ok and gui.Parent then
            return
        end
    end
end

local function makeDraggable(handle, target, track)
    local active, startPointer, startPosition

    track(handle.InputBegan:Connect(function(input)
        if not isPress(input) then
            return
        end
        active = input
        startPointer = input.Position
        startPosition = target.Position
    end))

    track(UIS.InputChanged:Connect(function(input)
        if not active then
            return
        end
        if input ~= active and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local delta = input.Position - startPointer
        target.Position = UDim2.new(
            startPosition.X.Scale, startPosition.X.Offset + delta.X,
            startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
        )
    end))

    track(UIS.InputEnded:Connect(function(input)
        if active and isSamePointer(input, active) then
            active = nil
        end
    end))
end

local function buildToggle(row, options, track)
    local callback = options.Callback or function() end
    local state = options.Default == true
    local description = options.Description

    label({
        Size = UDim2.new(1, -64, 0, description and 22 or 40),
        Position = UDim2.fromOffset(12, description and 6 or 0),
        Text = options.Name,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = row,
    })
    if description then
        label({
            Size = UDim2.new(1, -64, 0, 14),
            Position = UDim2.fromOffset(12, 28),
            Text = description,
            TextSize = 11,
            TextColor3 = Theme.TextMuted,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = row,
        })
    end
    local switch = create("Frame", {
        Size = UDim2.fromOffset(38, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = Theme.SwitchOff,
        BorderSizePixel = 0,
        Parent = row,
    }, {corner(1, 0)})
    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = switch,
    }, {corner(1, 0)})
    local hit = create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = row})

    local function render(animated)
        animate(switch, {BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff}, animated)
        animate(knob, {Position = state and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)}, animated)
    end
    render(false)

    local control = {}
    function control:Get()
        return state
    end
    function control:Set(value)
        state = value == true
        render(true)
        task.spawn(callback, state)
    end
    track(hit.Activated:Connect(function()
        control:Set(not state)
    end))
    return control
end

