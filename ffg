function Page:AddNumber(options)
    local callback = options.Callback or function() end
    local minValue, maxValue = options.Min, options.Max
    local value = options.Default or 0
    local row = newRow(self, 40)

    label({
        Size = UDim2.new(1, -124, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Text = options.Name,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = row,
    })

    local boxStroke = stroke(0.85)
    local box = create("TextBox", {
        Size = UDim2.fromOffset(92, 30),
        Position = UDim2.new(1, -104, 0.5, -15),
        BackgroundColor3 = Theme.RowColor,
        BackgroundTransparency = Theme.RowTransparency,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Theme.Font,
        Text = formatNumber(value),
        TextSize = 13,
        TextColor3 = Theme.Text,
        PlaceholderColor3 = Theme.TextMuted,
        Parent = row,
    }, {corner(0, Theme.RowCorner), boxStroke})

    local function clampValue(n)
        if minValue then n = math.max(minValue, n) end
        if maxValue then n = math.min(maxValue, n) end
        return n
    end

    self.Track(box.Focused:Connect(function()
        animate(boxStroke, {Color = Theme.Accent, Transparency = 0.3}, true)
    end))
    self.Track(box.FocusLost:Connect(function()
        animate(boxStroke, {Color = Theme.StrokeColor, Transparency = 0.85}, true)
        local n = tonumber((string.gsub(box.Text, ",", ".")))
        if n and n == n and math.abs(n) ~= math.huge then
            value = clampValue(n)
            task.spawn(callback, value)
        end
        box.Text = formatNumber(value)
    end))

    local control = {Box = box}
    function control:Get()
        return value
    end
    function control:Set(newValue)
        value = clampValue(newValue)
        box.Text = formatNumber(value)
        task.spawn(callback, value)
    end
    return control
end

