local function setArmed(state)
    if destroyed then
        return
    end
    confirming = state
    animate(window.CloseButton, {
        BackgroundTransparency = state and 0 or 1,
        TextColor3 = state and Theme.OnDanger or Theme.TextMuted,
    }, true)
    animate(toast, {Position = state and ToastShown or ToastHidden}, true)
    unloadControl:SetText(state and "Press again to confirm" or "Unload")
end

local function destroy()
    if destroyed then
        return
    end
    destroyed = true
    writeJson(AutosavePath, snapshot(true))
    stop(false)
    if animConn then animConn:Disconnect() animConn = nil end
    if diedConn then diedConn:Disconnect() diedConn = nil end
    for _, c in ipairs(conns) do c:Disconnect() end
    table.clear(conns)
    window:Destroy()
    env.SolitudeTech = nil
end

requestUnload = function()
    confirmToken = confirmToken + 1
    if confirming then
        task.spawn(destroy)
        return
    end

    setArmed(true)
    local token = confirmToken
    task.delay(ConfirmTimeout, function()
        if token == confirmToken and confirming then
            setArmed(false)
        end
    end)
end

env.SolitudeTech = {destroy = destroy}