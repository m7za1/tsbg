local pingCache, pingAt = 0.05, -math.huge

local function bind(signal, fn)
    local c = signal:Connect(fn)
    conns[#conns + 1] = c
    return c
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function unitOr(v, fallback)
    if v.Magnitude > 0.001 then
        return v.Unit
    end
    return fallback
end

local function fireDash()
    local char = player.Character
    local communicate = char and char:FindFirstChild("Communicate")
    if not communicate then return end
    pcall(function()
        communicate:FireServer({
            Dash = Enum.KeyCode.W,
            Key = Enum.KeyCode.Q,
            Goal = "KeyPress",
        })
    end)
end

local function getPing()
    local now = os.clock()
    if now - pingAt < 0.25 then
        return pingCache
    end
    pingAt = now
    local ok, ms = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and type(ms) == "number" then
        pingCache = math.clamp(ms / 1000, 0, 0.25)
    else
        pingCache = 0.05
    end
    return pingCache
end

local function predict(targetRoot, lead)
    local v = targetRoot.AssemblyLinearVelocity
    return targetRoot.Position + Vector3.new(v.X, 0, v.Z) * (getPing() + lead)
end

local function getTarget(root)
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local best, bestDist = nil, Config.TargetRange
    for _, model in ipairs(live:GetChildren()) do
        if model:IsA("Model") and model ~= player.Character then
            local r = model:FindFirstChild("HumanoidRootPart")
            local h = model:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - root.Position).Magnitude
                if d < bestDist then
                    best, bestDist = r, d
                end
            end
        end
    end
    return best
end

local function getTorso(model)
    return model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("HumanoidRootPart")
end

local function getNearestTorso(root)
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local best, bestDist = nil, Config.TargetRange
    for _, model in ipairs(live:GetChildren()) do
        if model:IsA("Model") and model ~= player.Character then
            local h = model:FindFirstChildOfClass("Humanoid")
            local torso = getTorso(model)
            if torso and h and h.Health > 0 then
                local d = (torso.Position - root.Position).Magnitude
                if d < bestDist then
                    best, bestDist = torso, d
                end
            end
        end
    end
    return best
end

local function buildShape(origin, targetPos, facing)
    local toTarget = flat(targetPos - origin)
    local fwd = unitOr(toTarget, unitOr(flat(facing), Vector3.new(0, 0, -1)))
    local right = fwd:Cross(Vector3.yAxis)
    local s = math.max(toTarget.Magnitude / math.max(Config.TargetAt, 0.1), Config.MinStem) * Config.ShapeScale
    local shape = Shapes[Config.Shape] or Shapes.P
    local base = flat(origin)

    local pts = {}
    for i, p in ipairs(shape) do
        pts[i] = base + fwd * (p[2] * s) + right * (p[1] * s * Config.WidthScale)
    end
    return pts
end

local function redirect(root, dir, holdY)
    for _, obj in ipairs(root:GetChildren()) do
        if obj:IsA("BodyVelocity") then
            local v = obj.Velocity
            local spd = Vector3.new(v.X, 0, v.Z).Magnitude
            if spd > 1 then
                obj.Velocity = Vector3.new(dir.X * spd, holdY and 0 or v.Y, dir.Z * spd)
            end
        elseif obj:IsA("LinearVelocity") and obj.RelativeTo == Enum.ActuatorRelativeTo.World then
            local v = obj.VectorVelocity
            local spd = Vector3.new(v.X, 0, v.Z).Magnitude
            if spd > 1 then
                obj.VectorVelocity = Vector3.new(dir.X * spd, holdY and 0 or v.Y, dir.Z * spd)
            end
        end
    end
end

local function forceCancel()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, obj in ipairs(root:GetChildren()) do
        if obj:IsA("BodyVelocity") or obj:IsA("LinearVelocity") then
            obj:Destroy()
        end
    end
    local v = root.AssemblyLinearVelocity
    root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
end

local function attachCamera(root)
    if not Config.CamSmooth or camAttached then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    prevSubject = cam.CameraSubject
    camAttached = true
    pcall(function()
        cam.CameraType = Enum.CameraType.Attach
        cam.CameraSubject = root
    end)
end

local function releaseCamera()
    if not camAttached then return end
    camAttached = false
    local cam = workspace.CurrentCamera
    if not cam then return end
    pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        cam.CameraType = Enum.CameraType.Custom
        if prevSubject and prevSubject.Parent then
            cam.CameraSubject = prevSubject
        else
            cam.CameraSubject = hum
        end
    end)
    prevSubject = nil
end

local function restoreCollisions()
    for part in pairs(noclipped) do
        if part.Parent then
            part.CanCollide = true
        end
        noclipped[part] = nil
    end
end

local StunWords = {"stun", "ragdoll"}

local function hasStunWord(name)
    name = string.lower(name)
    for _, word in ipairs(StunWords) do
        if string.find(name, word, 1, true) then
            return true
        end
    end
    return false
end

local function isStunned(char, hum)
    if hum.PlatformStand then return true end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
        return true
    end
    for name, value in pairs(char:GetAttributes()) do
        if value ~= false and value ~= 0 and value ~= nil and hasStunWord(name) then
            return true
        end
    end
    for _, child in ipairs(char:GetChildren()) do
        if hasStunWord(child.Name) then
            if child:IsA("BoolValue") then
                if child.Value then return true end
            elseif not child:IsA("BasePart") and not child:IsA("Accessory") then
                return true
            end
        end
    end
    return false
end

bind(RunService.Stepped, function()
    if not busy or not Config.Noclip then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local live = workspace:FindFirstChild("Live")
    if not root or not live then return end
    for _, model in ipairs(live:GetChildren()) do
        if model ~= char and model:IsA("Model") then
            local r = model:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - root.Position).Magnitude <= Config.NoclipRange then
                for _, part in ipairs(model:GetChildren()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                        noclipped[part] = true
                    end
                end
            end
        end
    end
end)

local function stop(hit)
    runId = runId + 1
    busy = false
    if steerConn then
        steerConn:Disconnect()
        steerConn = nil
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true end
    releaseCamera()
    restoreCollisions()
    if hit then forceCancel() end
end

local function execute()
    if busy or not Config.Enabled then return end
    if os.clock() - lastRun < Config.DashCooldown then return end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    if not getTarget(root) then return end

    busy = true
    runId = runId + 1
    local id = runId

    -- cancel when we take damage or get stunned during the run
    local lastHealth = hum.Health
    local watchStun = Config.CancelOnStun and not isStunned(char, hum)
    local function interrupted()
        local health = hum.Health
        if Config.CancelOnDamage and health < lastHealth - 0.01 then
            return true
        end
        lastHealth = health
        return watchStun and isStunned(char, hum)
    end

    task.spawn(function()
        task.wait(Config.JumpDelay)
        if id ~= runId then return end
        if not root.Parent or hum.Health <= 0 or interrupted() then
            stop(false)
            return
        end

        -- jump; with Height lock and no dash delay the lock would override it at once
        if Config.DashDelay > 0 or not Config.HeightLock then
            local v = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(v.X, Config.JumpVelocity, v.Z)
        end

        if Config.DashDelay > 0 then
            task.wait(Config.DashDelay)
            if id ~= runId then return end
            if not root.Parent or hum.Health <= 0 or interrupted() then
                stop(false)
                return
            end
        end

        local targetRoot = getTarget(root)
        if not targetRoot then
            stop(false)
            return
        end

        lastRun = os.clock()

        local origin = root.Position
        local targetPos = predict(targetRoot, Config.Lead)
        local pts = buildShape(origin, targetPos, root.CFrame.LookVector)

        -- the shape is stored relative to the target so it can follow it
        local targetFlat = flat(targetPos)
        local rel = {}
        local segDirs = {}
        local prev = flat(origin)
        for i = 1, #pts do
            rel[i] = pts[i] - targetFlat
            segDirs[i] = unitOr(pts[i] - prev, Vector3.new(0, 0, -1))
            prev = pts[i]
        end

        local center = targetFlat
        local idx = 1
        local lastDir = segDirs[1]
        local t0 = os.clock()
        local nextCheck = 0

        local lastTorso = getTorso(targetRoot.Parent)

        hum.AutoRotate = false
        attachCamera(root)

        fireDash()

        steerConn = RunService.Heartbeat:Connect(function(dt)
            if id ~= runId then return end
            if not root.Parent or hum.Health <= 0 or not targetRoot.Parent then
                stop(false)
                return
            end

            local now = os.clock()
            if now - t0 > Config.MaxTime then
                stop(false)
                return
            end
            if now >= nextCheck then
                nextCheck = now + 0.05
                if interrupted() then
                    stop(false)
                    return
                end
            end

            if Config.TrackTarget then
                local want = flat(predict(targetRoot, Config.Lead))
                local trackAlpha = 1 - (1 - math.clamp(Config.TrackLerp, 0, 1)) ^ (math.min(dt, 0.1) * 60)
                center = center:Lerp(want, trackAlpha)
            end

            local rootPos = root.Position
            local rootFlat = flat(rootPos)
            while idx <= #pts do
                local to = center + rel[idx] - rootFlat
                if to.Magnitude < Config.ReachRadius or to:Dot(segDirs[idx]) < 0 then
                    idx = idx + 1
                else
                    break
                end
            end

            local dir, lerp
            if idx <= #pts then
                dir = unitOr(center + rel[idx] - rootFlat, lastDir)
                lerp = Config.TurnLerp
            elseif Config.HomeAfter then
                local to = flat(predict(targetRoot, 0.1)) - rootFlat
                if to.Magnitude < Config.HitDistance then
                    stop(true)
                    return
                end
                dir = unitOr(to, lastDir)
                lerp = Config.LegLerp
            else
                stop(true)
                return
            end
            lastDir = dir

            local alpha = 1 - (1 - math.clamp(lerp, 0, 1)) ^ (math.min(dt, 0.1) * 60)
            local goal = CFrame.lookAt(rootPos, rootPos + dir)
            local cf = root.CFrame:Lerp(goal, alpha)

            local holdY = false
            if Config.HeightLock then
                local torso = getNearestTorso(root) or lastTorso
                if torso and torso.Parent then
                    lastTorso = torso
                    holdY = true
                    local goalY = torso.Position.Y + Config.HeightOffset
                    local heightAlpha = 1 - (1 - math.clamp(Config.HeightLerp, 0, 1)) ^ (math.min(dt, 0.1) * 60)
                    cf = cf + Vector3.new(0, (goalY - rootPos.Y) * heightAlpha, 0)
                    local vel = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                end
            end

            root.CFrame = cf
            redirect(root, unitOr(flat(root.CFrame.LookVector), dir), holdY)
        end)
    end)
end

local function numericId(str)
    return tostring(str):match("%d+")
end

local function onAnimation(track)
    local anim = track.Animation
    if not anim then return end
    local id = numericId(anim.AnimationId)
    if Config.DebugAnimIds then
        print("[Solitude Tech] anim id:", id)
    end
    if id and id == numericId(Config.UppercutAnimId) then
        execute()
    end
end

local function hookCharacter(char)
    stop(false)
    if animConn then animConn:Disconnect() animConn = nil end
    if diedConn then diedConn:Disconnect() diedConn = nil end
    local hum = char:WaitForChild("Humanoid")
    if destroyed or player.Character ~= char then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5) or hum
    if destroyed or player.Character ~= char then return end
    animConn = animator.AnimationPlayed:Connect(onAnimation)
    diedConn = hum.Died:Connect(function() stop(false) end)
end

bind(player.CharacterAdded, hookCharacter)
if player.Character then
    task.spawn(hookCharacter, player.Character)
end

