    Text = hasFiles and "Pick a preset or type a name" or "Executor has no file access",
})

local selectedConfig
local configNames = {}
local configList
local configButtons
local deleteArmed = false
local deleteToken = 0

local function setStatus(text)
    status:SetText(text)
end

local function refreshList()
    configNames = listConfigs()
    configList:SetItems(configNames, selectedConfig)
end

local function currentName()
    local name = cleanName(nameInput.Box.Text)
    if name == "" then
        name = selectedConfig or ""
    end
    return name
end

configButtons = configsPage:AddButtonRow({
    {Name = "Save", Callback = function()
        if not hasFiles then
            setStatus("Executor has no file access")
            return
        end
        local name = cleanName(nameInput.Box.Text)
        if name == "" then
            setStatus("Enter a name first")
            return
        end
        if writeJson(configPath(name), snapshot(false)) then
            selectedConfig = name
            nameInput.Box.Text = name
            setStatus("Saved: " .. name)
            refreshList()
        else
            setStatus("Could not save the file")
        end
    end},
    {Name = "Load", Style = "neutral", Callback = function()
        if not hasFiles then
            setStatus("Executor has no file access")
            return
        end
        local name = currentName()
        if name == "" then
            setStatus("Pick a preset first")
            return
        end
        local data = readJson(configPath(name))
        if not data then
            setStatus("Config not found: " .. name)
            return
        end
        for key, value in pairs(sanitize(data, false)) do
            local control = controlsByKey[key]
            if control then
                control:Set(value)
            end
        end
        selectedConfig = name
        nameInput.Box.Text = name
        setStatus("Loaded: " .. name)
        refreshList()
    end},
    {Name = "Delete", Style = "danger", Callback = function()
        local name = currentName()
        if name == "" then
            setStatus("Pick a preset first")
            return
        end

        deleteToken = deleteToken + 1
        if not deleteArmed then
            deleteArmed = true
            configButtons[3]:SetText("Tap again")
            local token = deleteToken
            task.delay(ConfirmTimeout, function()
                if token == deleteToken and deleteArmed and not destroyed then
                    deleteArmed = false
                    configButtons[3]:SetText("Delete")
                end
            end)
            return
        end

        deleteArmed = false
        configButtons[3]:SetText("Delete")
        if typeof(delfile) ~= "function" then
            setStatus("Executor can't delete files")
            return
        end
        local ok = pcall(delfile, configPath(name))
        if ok then
            if selectedConfig == name then
                selectedConfig = nil
            end
            setStatus("Deleted: " .. name)
            refreshList()
        else
            setStatus("Could not delete: " .. name)
        end
    end},
})

