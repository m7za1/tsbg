--// CORE LOGIC LETHAL
local function setup(char)
    if not isCurrent() then return end
    local hum = char:WaitForChild("Humanoid")
    hum.AnimationPlayed:Connect(function(track)
        if not isCurrent() then return end
        
        -- KIỂM TRA COOLDOWN ANIMATION (DÙNG ID SỐ)
        local animId = getId(track.Animation.AnimationId)
        if Config.CooldownActive and Config.CooldownAnims[animId] then
            startCooldown(5)
        end
        
        -- CHẶN HOÀN TOÀN AUTO KHI BẬT TOUCH MODE
        if Config.TouchMode then return end
        
        if not Config.Enabled then return end
        if track.Animation.AnimationId == Config.LethalAnim then
            executeLethal()
        end
    end)
end

