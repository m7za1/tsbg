local Root = "techinified"
local Folder = Root .. "/solitudetech"
local ConfigFolder = Folder .. "/configs"
local AutosavePath = Folder .. "/autosave.json"

local hasFiles = typeof(writefile) == "function"
    and typeof(readfile) == "function"
    and typeof(isfile) == "function"

local function clampKey(key, value)
    local limit = Limits[key]
    if limit then
        return math.clamp(value, limit[1], limit[2])
    end
    return value
end

local function ensureFolders()
    if typeof(makefolder) ~= "function" then return end
    for _, path in ipairs({Root, Folder, ConfigFolder}) do
        local found = false
        if typeof(isfolder) == "function" then
            local ok, result = pcall(isfolder, path)
            found = ok and result == true
        end
        if not found then
            pcall(makefolder, path)
        end
    end
end

local function writeJson(path, data)
    if not hasFiles then return false end
    ensureFolders()
    local ok = pcall(function()
        writefile(path, HttpService:JSONEncode(data))
    end)
    return ok
end

local function readJson(path)
    if not hasFiles then return nil end
    local ok, raw = pcall(function()
        if not isfile(path) then return nil end
        return readfile(path)
    end)
    if not ok or type(raw) ~= "string" then return nil end
    local decodedOk, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if decodedOk and type(decoded) == "table" then
        return decoded
    end
    return nil
end

local function sanitize(data, withEnabled)
    local out = {}
    if type(data) ~= "table" then return out end
    for _, key in ipairs(TuneKeys) do
        local value = data[key]
        if key == "Shape" then
            if type(value) == "string" and Shapes[value] then
                out[key] = value
            end
        elseif type(value) == "number" and value == value and math.abs(value) ~= math.huge then
            out[key] = clampKey(key, value)
        end
    end
    if withEnabled and type(data.Enabled) == "boolean" then
        out.Enabled = data.Enabled
    end
    return out
end

local function snapshot(withEnabled)
    local data = {}
    for _, key in ipairs(TuneKeys) do
        data[key] = Config[key]
    end
    if withEnabled then
        data.Enabled = Config.Enabled
    end
    return data
end

for key, value in pairs(sanitize(readJson(AutosavePath), true)) do
    Config[key] = value
end

