local runService = game:GetService("RunService")
local userInputService = game:GetService("UserInputService")
local coreGui = game:GetService("CoreGui")
local lp = game:GetService("Players").LocalPlayer

if getgenv().rPatternUnload then
    pcall(getgenv().rPatternUnload)
end

getgenv().rPatternSettings = {
    enabled = true,
    dashCooldown = true,
    noClip = true,
    dashDelay = 0.22,
    patternDelay = 0.25,
    patternDuration = 0.7,
    jumpDelay = 0.1,
    jumpForce = 30,
}

local settings = getgenv().rPatternSettings

local uppercutAnimations = {
    ["rbxassetid://10503381238"] = true,
}

local cooldownDuration = 4.9
local connections = {}
local busy = false
local cooldownEnd = 0
local activeGyro = nil
local activeDrag = nil

local accentColor = Color3.fromRGB(150, 90, 255)
local windowColor = Color3.fromRGB(18, 16, 26)
local rowColor = Color3.fromRGB(30, 27, 44)
local offColor = Color3.fromRGB(70, 66, 90)
local textColor = Color3.fromRGB(235, 232, 245)

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function buildRoute()
    local points = {
        Vector2.new(0, 0),
        Vector2.new(0, 1),
        Vector2.new(0.25, 1),
    }

    local arcSteps = 12
    for step = 1, arcSteps do
        local angle = math.pi / 2 - math.pi * step / arcSteps
        table.insert(points, Vector2.new(0.25 + 0.25 * math.cos(angle), 0.75 + 0.25 * math.sin(angle)))
    end

    table.insert(points, Vector2.new(0, 0.5))
    table.insert(points, Vector2.new(0.5, 0))

    local segments = {}
    local totalLength = 0
    for index = 1, #points - 1 do
        local offset = points[index + 1] - points[index]
        if offset.Magnitude > 0 then
            table.insert(segments, {length = offset.Magnitude, direction = offset.Unit})
            totalLength += offset.Magnitude
        end
    end

    return segments, totalLength
end

local routeSegments, routeLength = buildRoute()

local function routeDirectionAt(progress)
    local remaining = math.clamp(progress, 0, 1) * routeLength
    for _, segment in ipairs(routeSegments) do
        if remaining <= segment.length then
            return segment.direction
        end
        remaining -= segment.length
    end
    return routeSegments[#routeSegments].direction
end

local function fireDash(character)
    local communicate = character:FindFirstChild("Communicate")
    if communicate then
        communicate:FireServer({
            Dash = Enum.KeyCode.W,
            Key = Enum.KeyCode.Q,
            Goal = "KeyPress",
        })
    end
end

local function applyJump(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and settings.jumpForce > 0 then
        local velocity = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, settings.jumpForce, velocity.Z)
    end
end

local function runPattern(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then
        return
    end

    local startRotation = root.CFrame - root.CFrame.Position

    local gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(0, math.huge, 0)
    gyro.P = 40000
    gyro.D = 600
    gyro.CFrame = root.CFrame
    gyro.Parent = root
    activeGyro = gyro

    humanoid.AutoRotate = false

    local duration = math.max(settings.patternDuration, 0.05)
    local startTime = os.clock()
    while root.Parent and os.clock() - startTime < duration do
        local direction = routeDirectionAt((os.clock() - startTime) / duration)
        gyro.CFrame = startRotation * CFrame.lookAt(Vector3.zero, Vector3.new(direction.X, 0, -direction.Y))
        runService.Heartbeat:Wait()
    end

    gyro:Destroy()
    activeGyro = nil
    humanoid.AutoRotate = true
end

local function startSequence(character)
    if not settings.enabled or busy then
        return
    end
    if settings.dashCooldown and os.clock() < cooldownEnd then
        return
    end

    busy = true
    cooldownEnd = os.clock() + cooldownDuration

    task.delay(settings.dashDelay, fireDash, character)
    task.delay(settings.jumpDelay, applyJump, character)

    task.spawn(function()
        task.wait(settings.patternDelay)
        pcall(runPattern, character)
        busy = false
    end)
end

local function hookCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then
        return
    end
    local animator = humanoid:WaitForChild("Animator", 10)
    if not animator then
        return
    end

    connect(animator.AnimationPlayed, function(track)
        if track.Animation and uppercutAnimations[track.Animation.AnimationId] then
            startSequence(character)
        end
    end)
end

local function addCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = instance
end

local function makeLabel(parent, text, textSize)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextSize = textSize
    label.Font = Enum.Font.GothamMedium
    label.TextColor3 = textColor
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

local function createInterface(onClose)
    local gui = Instance.new("ScreenGui")
    gui.Name = "rPatternInterface"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999

    local parented = pcall(function()
        gui.Parent = (gethui and gethui()) or coreGui
    end)
    if not parented then
        gui.Parent = lp:WaitForChild("PlayerGui")
    end

    local window = Instance.new("Frame")
    window.Size = UDim2.fromOffset(250, 0)
    window.AutomaticSize = Enum.AutomaticSize.Y
    window.Position = UDim2.fromOffset(20, 70)
    window.BackgroundColor3 = windowColor
    window.BackgroundTransparency = 0.05
    window.BorderSizePixel = 0
    window.Parent = gui
    addCorner(window, 12)

    local outline = Instance.new("UIStroke")
    outline.Color = accentColor
    outline.Thickness = 1.5
    outline.Parent = window

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 10)
    padding.PaddingBottom = UDim.new(0, 10)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.Parent = window

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = window

    local order = 0
    local function nextOrder()
        order += 1
        return order
    end

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 26)
    titleBar.BackgroundTransparency = 1
    titleBar.LayoutOrder = nextOrder()
    titleBar.Parent = window

    local title = makeLabel(titleBar, "R Pattern", 18)
    title.Size = UDim2.new(1, -30, 1, 0)
    title.TextColor3 = accentColor
    title.Font = Enum.Font.GothamBold

    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.fromOffset(26, 26)
    closeButton.Position = UDim2.new(1, -26, 0, 0)
    closeButton.BackgroundColor3 = rowColor
    closeButton.Text = "X"
    closeButton.TextSize = 14
    closeButton.Font = Enum.Font.GothamBold
    closeButton.TextColor3 = textColor
    closeButton.Parent = titleBar
    addCorner(closeButton, 6)
    closeButton.Activated:Connect(onClose)

    titleBar.InputBegan:Connect(function(input)
        if not isPress(input) then
            return
        end
        local origin = input.Position
        local startPosition = window.Position
        activeDrag = function(position)
            local delta = position - origin
            window.Position = UDim2.fromOffset(startPosition.X.Offset + delta.X, startPosition.Y.Offset + delta.Y)
        end
    end)

    local function createToggle(label, key)
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 32)
        row.BackgroundColor3 = rowColor
        row.Text = ""
        row.AutoButtonColor = false
        row.LayoutOrder = nextOrder()
        row.Parent = window
        addCorner(row, 8)

        local name = makeLabel(row, label, 14)
        name.Position = UDim2.fromOffset(10, 0)
        name.Size = UDim2.new(1, -60, 1, 0)

        local pill = Instance.new("Frame")
        pill.Size = UDim2.fromOffset(36, 18)
        pill.Position = UDim2.new(1, -46, 0.5, -9)
        pill.BorderSizePixel = 0
        pill.Parent = row
        addCorner(pill, 9)

        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(14, 14)
        knob.BackgroundColor3 = textColor
        knob.BorderSizePixel = 0
        knob.Parent = pill
        addCorner(knob, 7)

        local function render()
            local isOn = settings[key]
            pill.BackgroundColor3 = isOn and accentColor or offColor
            knob.Position = isOn and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        end

        row.Activated:Connect(function()
            settings[key] = not settings[key]
            render()
        end)
        render()
    end

    local function createSlider(label, key, minimum, maximum, step, valueFormat)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 48)
        row.BackgroundColor3 = rowColor
        row.LayoutOrder = nextOrder()
        row.Parent = window
        addCorner(row, 8)

        local name = makeLabel(row, label, 13)
        name.Position = UDim2.fromOffset(10, 4)
        name.Size = UDim2.new(0.6, 0, 0, 18)

        local valueLabel = makeLabel(row, "", 13)
        valueLabel.Position = UDim2.new(0.6, 0, 0, 4)
        valueLabel.Size = UDim2.new(0.4, -10, 0, 18)
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.TextColor3 = accentColor

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -20, 0, 6)
        track.Position = UDim2.fromOffset(10, 32)
        track.BackgroundColor3 = offColor
        track.BorderSizePixel = 0
        track.Parent = row
        addCorner(track, 3)

        local fill = Instance.new("Frame")
        fill.BackgroundColor3 = accentColor
        fill.BorderSizePixel = 0
        fill.Parent = track
        addCorner(fill, 3)

        local hitbox = Instance.new("TextButton")
        hitbox.Size = UDim2.new(1, 0, 0, 28)
        hitbox.Position = UDim2.fromOffset(0, 20)
        hitbox.BackgroundTransparency = 1
        hitbox.Text = ""
        hitbox.Parent = row

        local function render()
            local ratio = (settings[key] - minimum) / (maximum - minimum)
            fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
            valueLabel.Text = string.format(valueFormat, settings[key])
        end

        local function updateFromPosition(position)
            local ratio = math.clamp((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local value = minimum + (maximum - minimum) * ratio
            settings[key] = math.clamp(math.floor(value / step + 0.5) * step, minimum, maximum)
            render()
        end

        hitbox.InputBegan:Connect(function(input)
            if isPress(input) then
                activeDrag = updateFromPosition
                updateFromPosition(input.Position)
            end
        end)
        render()
    end

    createToggle("Enabled", "enabled")
    createToggle("Dash Cooldown", "dashCooldown")
    createToggle("NoClip", "noClip")
    createSlider("Dash Delay", "dashDelay", 0, 1, 0.01, "%.2fs")
    createSlider("Pattern Delay", "patternDelay", 0, 1, 0.01, "%.2fs")
    createSlider("Pattern Duration", "patternDuration", 0, 2, 0.01, "%.2fs")
    createSlider("Jump Delay", "jumpDelay", 0, 1, 0.01, "%.2fs")
    createSlider("Jump Force", "jumpForce", 0, 100, 1, "%d")

    return gui
end

local interface

local function unload()
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)

    if activeGyro then
        activeGyro:Destroy()
        activeGyro = nil
    end
    if interface then
        interface:Destroy()
    end
    getgenv().rPatternUnload = nil
end

interface = createInterface(unload)
getgenv().rPatternUnload = unload

connect(userInputService.InputChanged, function(input)
    if activeDrag and isMove(input) then
        activeDrag(input.Position)
    end
end)

connect(userInputService.InputEnded, function(input)
    if isPress(input) then
        activeDrag = nil
    end
end)

connect(runService.Stepped, function()
    if not settings.noClip or not lp.Character then
        return
    end
    for _, part in ipairs(lp.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end)

connect(lp.CharacterAdded, function(character)
    task.spawn(hookCharacter, character)
end)

if lp.Character then
    task.spawn(hookCharacter, lp.Character)
end